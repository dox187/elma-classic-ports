+/* Label 254 is reserved by this renderer; the SDL PSL1GHT video driver uses
+   no labels. A backend release waits for render writes, unlike a FIFO REF. */
+#define ELMA_BACKEND_LABEL 254
+static u32 PSL1GHT_BackendBarrier(PSL1GHT_RenderData *data)
+{
+    const u32 value=++data->fence_serial;
+    rsxSetWriteBackendLabel(data->context,ELMA_BACKEND_LABEL,value);
+    rsxSetWaitLabel(data->context,ELMA_BACKEND_LABEL,value);
+    return value;
+}
+static void PSL1GHT_Finish(PSL1GHT_RenderData *data)
+{
+    if (data->gpu_pending) {
+        const u32 value=PSL1GHT_BackendBarrier(data);
+        rsxFlushBuffer(data->context);
+        while(*(vu32 *)gcmGetLabelAddress(ELMA_BACKEND_LABEL)!=value) usleep(30);
+        data->gpu_pending=SDL_FALSE;
+    }
+}
