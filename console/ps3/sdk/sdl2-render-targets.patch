+    f32 offset[4]={dst->w*.5f, dst->h*.5f, .5f, 0}; int i;
+    SDL_zero(sf);
+    sf.colorFormat=GCM_SURFACE_A8R8G8B8; sf.colorTarget=GCM_SURFACE_TARGET_0;
+    for(i=0;i<4;++i) {sf.colorLocation[i]=GCM_LOCATION_RSX;sf.colorPitch[i]=64;}
+    rsxAddressToOffset(dst->pixels, &sf.colorOffset[0]); sf.colorPitch[0]=dst->pitch;
+    sf.depthFormat=GCM_SURFACE_ZETA_Z24S8;sf.depthLocation=GCM_LOCATION_RSX;sf.depthPitch=64;
+    sf.type=GCM_SURFACE_TYPE_LINEAR;sf.antiAlias=GCM_SURFACE_CENTER_1;
+    sf.width=dst->w;sf.height=dst->h;
+    rsxSetSurface(c,&sf);
+    rsxSetColorMask(c,GCM_COLOR_MASK_R|GCM_COLOR_MASK_G|GCM_COLOR_MASK_B|GCM_COLOR_MASK_A);
