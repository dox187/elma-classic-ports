+/* Rasterize directly into the same linear ARGB surfaces. No depth allocation is
+   needed: depth/stencil tests and writes are disabled. Keep the old 2D transfer
+   path as an explicit diagnostic fallback and on tiny shader allocation failure. */
+static SDL_bool PSL1GHT_QuadReady(PSL1GHT_RenderData *data)
+{
+    if (SDL_GetHintBoolean("ELMA_PS3_SDL_2D", SDL_FALSE)) return SDL_FALSE;
+    if(data->quad_unavailable) return SDL_FALSE;
+    if (!data->quad_fragment) {
+        void *ucode; u32 size;
+        rsxFragmentProgramGetUCode((const rsxFragmentProgram *)elma_fp, &ucode, &size);
+        data->quad_fragment = rsxMemalign(64, size);
+        if (!data->quad_fragment) {data->quad_unavailable=SDL_TRUE;return SDL_FALSE;}
+        SDL_memcpy(data->quad_fragment, ucode, size);
+        rsxAddressToOffset(data->quad_fragment, &data->quad_fragment_offset);
+        rsxFragmentProgramGetUCode((const rsxFragmentProgram *)elma_solid_fp,&ucode,&size);
+        data->solid_fragment=rsxMemalign(64,size);
+        if(!data->solid_fragment) {
+            rsxFree(data->quad_fragment);data->quad_fragment=NULL;
+            data->quad_unavailable=SDL_TRUE;return SDL_FALSE;
+        }
+        SDL_memcpy(data->solid_fragment,ucode,size);
+        rsxAddressToOffset(data->solid_fragment,&data->solid_fragment_offset);
+        rsxFragmentProgramGetUCode((const rsxFragmentProgram *)elma_pixelart_fp,&ucode,&size);
+        data->pixelart_fragment=rsxMemalign(64,size);
+        if(!data->pixelart_fragment) {
+            rsxFree(data->solid_fragment);data->solid_fragment=NULL;
+            rsxFree(data->quad_fragment);data->quad_fragment=NULL;
+            data->quad_unavailable=SDL_TRUE;return SDL_FALSE;
+        }
