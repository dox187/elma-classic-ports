+/* PSL1GHT is fixed to the selected physical video mode, even if a caller
+   requested a different SDL window size. Report the actual renderable extent. */
+static int PSL1GHT_GetOutputSize(SDL_Renderer *renderer,int *w,int *h)
+{
+    PSL1GHT_RenderData *data=(PSL1GHT_RenderData *)renderer->driverdata;
+    if(w) *w=data->screens[0]->w;
+    if(h) *h=data->screens[0]->h;
+    return 0;
+}
