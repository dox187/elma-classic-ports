; The memory map and the header of the ROM (LoROM, FastROM), included by
; every source; the Makefile writes build/gen/hdr.asm from this.

.DEFINE FASTROM 1

.MEMORYMAP
  SLOTSIZE $8000
  DEFAULTSLOT 0
  SLOT 0 $8000              ; ROM
  SLOT 1 $0 $2000           ; low RAM (bank 0, $0000-$1FFF)
  SLOT 2 $2000 $E000        ; RAM of bank $7E from $2000
  SLOT 3 $0 $10000          ; a whole bank of RAM ($7F)
.ENDME

.ROMBANKSIZE $8000
.ROMBANKS @ROMBANKS@

.SNESHEADER
  ID "SNES"
  NAME "ELASTO MANIA SNES    "
  FASTROM
  LOROM
  CARTRIDGETYPE $02         ; ROM, RAM and battery
  ROMSIZE @ROMSIZE@
  SRAMSIZE $03              ; 8 KB
  COUNTRY $01               ; tools/romfix.py sets it for PAL
  LICENSEECODE $00
  VERSION $00
.ENDSNES

.SNESNATIVEVECTOR
  COP EmptyHandler
  BRK EmptyHandler
  ABORT EmptyHandler
  NMI core_nmi
  IRQ core_irq
.ENDNATIVEVECTOR

.SNESEMUVECTOR
  COP EmptyHandler
  ABORT EmptyHandler
  NMI EmptyHandler
  RESET tcc__start
  IRQBRK EmptyHandler
.ENDEMUVECTOR

.BASE $80
