; Experimental native spring/damper acceleration component; no production calls.
;
; WIDE_FORCE_COMPONENT gumi, relative_rate, active, output, fallback, scratch
; Offsets refer to the current 256-byte direct page (D must be page aligned).
; gumi: signed 48-bit Q32 (6 bytes); relative_rate: signed 48-bit Q40 (6).
; active: byte; output: signed 48-bit Q40 (6); fallback: byte; scratch: 10.
; All must fit in DP;
; scratch/fallback must not overlap any other argument. Output may alias an
; input because every input byte is consumed before output writes begin.
; Entry A/X/Y 16-bit; clobbers A,X,flags; preserves Y,D,DB; exits A 16-bit.
;
; Exact accepted equation, with ONE nearest-half-away rounding:
; round((active*gumi*32009962*256 + relative_rate*586263036)/2^30).
; These independently rounded Q30 coefficients with gumi Q32 passed both
; the 134-case acceptance corpus and 242-case holdout in the host PC oracle.
;
; Fast bounds: -8m <= gumi < 8m and -.25m/step <= relative_rate < .25m/step.
; fallback=0 means output is valid; fallback=1 means output is UNCHANGED and
; caller MUST use an exact wider path. No clamp or approximate substitute.
; Active=0 skips spring work. No PPU or CPU math registers are touched.
; Tables generated by wide_force_gen.py require 8192 ROM bytes (four tables
; of 256 exact 8-byte products). Generate wide_force_tables.inc and add its
; directory to the assembler include path. Tables may occupy any ROM bank.
;
; The 9-byte numerator keeps all guard/rounding bits. Bounds limit its
; magnitude below 2^69, safely inside signed 72, and result inside signed 48.

.MACRO WIDE_FORCE_COMPONENT
sep #$20
stz.b (\5)+0
rep #$20
lda.b (\1)+4
clc
adc #8
cmp #16
bcc wide_force_gumi_valid\@
jmp wide_force_fallback\@
wide_force_gumi_valid\@:
lda.b (\2)+4
clc
adc #64
cmp #128
bcc wide_force_rate_valid\@
jmp wide_force_fallback\@
wide_force_rate_valid\@:
rep #$20
stz.b (\6)+0
stz.b (\6)+2
stz.b (\6)+4
stz.b (\6)+6
sep #$20
stz.b (\6)+8
lda.b (\3)+0
bne wide_force_table_spring\@
rep #$20
jmp wide_force_table_damper\@
wide_force_table_spring\@:
rep #$20
lda.b (\1)+0
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_s_unsigned+0,x
adc.b (\6)+1
sta.b (\6)+1
lda.l wide_force_s_unsigned+2,x
adc.b (\6)+3
sta.b (\6)+3
lda.l wide_force_s_unsigned+4,x
adc.b (\6)+5
sta.b (\6)+5
bcc wide_force_tail_128\@
lda #0
adc.b (\6)+7
sta.b (\6)+7
wide_force_tail_128\@:
lda.b (\1)+1
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_s_unsigned+0,x
adc.b (\6)+2
sta.b (\6)+2
lda.l wide_force_s_unsigned+2,x
adc.b (\6)+4
sta.b (\6)+4
lda.l wide_force_s_unsigned+4,x
adc.b (\6)+6
sta.b (\6)+6
bcc wide_force_tail_129\@
sep #$20
lda #0
adc.b (\6)+8
sta.b (\6)+8
rep #$20
wide_force_tail_129\@:
lda.b (\1)+2
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_s_unsigned+0,x
adc.b (\6)+3
sta.b (\6)+3
lda.l wide_force_s_unsigned+2,x
adc.b (\6)+5
sta.b (\6)+5
lda.l wide_force_s_unsigned+4,x
adc.b (\6)+7
sta.b (\6)+7
lda.b (\1)+3
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_s_unsigned+0,x
adc.b (\6)+4
sta.b (\6)+4
lda.l wide_force_s_unsigned+2,x
adc.b (\6)+6
sta.b (\6)+6
sep #$20
lda.l wide_force_s_unsigned+4,x
adc.b (\6)+8
sta.b (\6)+8
rep #$20
lda.b (\1)+4
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_s_signed+0,x
adc.b (\6)+5
sta.b (\6)+5
lda.l wide_force_s_signed+2,x
adc.b (\6)+7
sta.b (\6)+7
wide_force_table_damper\@:
rep #$20
lda.b (\2)+0
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_d_unsigned+0,x
adc.b (\6)+0
sta.b (\6)+0
lda.l wide_force_d_unsigned+2,x
adc.b (\6)+2
sta.b (\6)+2
lda.l wide_force_d_unsigned+4,x
adc.b (\6)+4
sta.b (\6)+4
bcc wide_force_tail_134\@
lda #0
adc.b (\6)+6
sta.b (\6)+6
bcc wide_force_tail_134\@
sep #$20
lda #0
adc.b (\6)+8
sta.b (\6)+8
rep #$20
wide_force_tail_134\@:
lda.b (\2)+1
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_d_unsigned+0,x
adc.b (\6)+1
sta.b (\6)+1
lda.l wide_force_d_unsigned+2,x
adc.b (\6)+3
sta.b (\6)+3
lda.l wide_force_d_unsigned+4,x
adc.b (\6)+5
sta.b (\6)+5
bcc wide_force_tail_135\@
lda #0
adc.b (\6)+7
sta.b (\6)+7
wide_force_tail_135\@:
lda.b (\2)+2
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_d_unsigned+0,x
adc.b (\6)+2
sta.b (\6)+2
lda.l wide_force_d_unsigned+2,x
adc.b (\6)+4
sta.b (\6)+4
lda.l wide_force_d_unsigned+4,x
adc.b (\6)+6
sta.b (\6)+6
bcc wide_force_tail_136\@
sep #$20
lda #0
adc.b (\6)+8
sta.b (\6)+8
rep #$20
wide_force_tail_136\@:
lda.b (\2)+3
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_d_unsigned+0,x
adc.b (\6)+3
sta.b (\6)+3
lda.l wide_force_d_unsigned+2,x
adc.b (\6)+5
sta.b (\6)+5
lda.l wide_force_d_unsigned+4,x
adc.b (\6)+7
sta.b (\6)+7
lda.b (\2)+4
and #$00ff
asl a
asl a
asl a
tax
clc
lda.l wide_force_d_signed+0,x
adc.b (\6)+4
sta.b (\6)+4
lda.l wide_force_d_signed+2,x
adc.b (\6)+6
sta.b (\6)+6
sep #$20
lda.l wide_force_d_signed+4,x
adc.b (\6)+8
sta.b (\6)+8
rep #$20
sep #$20
lda.b (\6)+8
sta.b (\6)+9
bpl wide_force_magnitude_done\@
rep #$20
sec
lda #0
sbc.b (\6)+0
sta.b (\6)+0
lda #0
sbc.b (\6)+2
sta.b (\6)+2
lda #0
sbc.b (\6)+4
sta.b (\6)+4
lda #0
sbc.b (\6)+6
sta.b (\6)+6
sep #$20
lda #0
sbc.b (\6)+8
sta.b (\6)+8
wide_force_magnitude_done\@:
rep #$20
lda.b (\6)+3
asl a
asl a
xba
sta.b (\4)+0
lda.b (\6)+4
asl a
asl a
xba
sta.b (\4)+1
lda.b (\6)+5
asl a
asl a
xba
sta.b (\4)+2
lda.b (\6)+6
asl a
asl a
xba
sta.b (\4)+3
lda.b (\6)+7
asl a
asl a
xba
sta.b (\4)+4
lda.b (\6)+8
and #$00ff
asl a
asl a
xba
sep #$20
sta.b (\4)+5
rep #$20
lda.b (\6)+2
and #$2000
beq wide_force_rounded\@
inc.b (\4)+0
bne wide_force_rounded\@
inc.b (\4)+2
bne wide_force_rounded\@
inc.b (\4)+4
wide_force_rounded\@:
sep #$20
lda.b (\6)+9
bpl wide_force_end_positive\@
rep #$20
sec
lda #0
sbc.b (\4)+0
sta.b (\4)+0
lda #0
sbc.b (\4)+2
sta.b (\4)+2
lda #0
sbc.b (\4)+4
sta.b (\4)+4
bra wide_force_end\@
wide_force_end_positive\@:
rep #$20
wide_force_end\@:
bra wide_force_exit\@
wide_force_fallback\@:
sep #$20
lda #1
sta.b (\5)+0
rep #$20
wide_force_exit\@:
.ENDM

.include "wide_force_tables.inc"
